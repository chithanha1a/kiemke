{
  "name": "kiemke-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "test:api": "node tests/comprehensive.integration.mjs",
    "test:browser": "node tests/browser.e2e.mjs",
    "deploy:cloudflare": "npm run build && wrangler d1 migrations apply kiemke --remote && wrangler deploy"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.64.1",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/vie": "^1.0.0",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "tesseract.js": "^5.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "undici": "8.12.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}